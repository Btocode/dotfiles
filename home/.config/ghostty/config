# Ghostty config — Ctrl+Shift+R reloads · Ctrl+Shift+P command palette
# Every option: `ghostty +show-config --default --docs` · Themes: `ghostty +list-themes`

# ---------- Look ----------
# Follows GNOME light/dark mode automatically
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = calt
font-feature = liga
adjust-cell-height = 0%
background-opacity = 0.96
unfocused-split-opacity = 0.80
split-divider-color = #45475a
window-padding-x = 14
window-padding-y = 4,2
window-padding-balance = false
window-padding-color = extend
minimum-contrast = 1.1
cursor-style = bar
cursor-style-blink = true

# ---------- Window & tabs ----------
window-width = 120
window-height = 32
window-theme = ghostty
gtk-titlebar-style = tabs
gtk-toolbar-style = flat
gtk-wide-tabs = false
window-subtitle = working-directory
window-new-tab-position = current
window-inherit-working-directory = true
confirm-close-surface = false
resize-overlay = never
scrollbar = system
# Keep Ghostty warm in the background so new windows open instantly
gtk-single-instance = true
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 10m

# ---------- Mouse & clipboard ----------
mouse-hide-while-typing = true
focus-follows-mouse = true
copy-on-select = clipboard
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
clipboard-read = ask
clipboard-write = allow
link-url = true
link-previews = true
right-click-action = context-menu
# No "Copied to clipboard" toast on every selection
app-notifications = no-clipboard-copy,config-reload

# ---------- Shell ----------
shell-integration = zsh
# sudo keeps terminfo · ssh copies Ghostty terminfo to servers automatically
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path
scrollback-limit = 100000000

# Desktop notification when a command taking >10s finishes while you're in another window
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s
bell-features = attention,title

# ---------- Keybindings ----------
# Ctrl+C copies when text is selected, otherwise sends interrupt as usual
keybind = performable:ctrl+c=copy_to_clipboard

# Splits (defaults Ctrl+Shift+O / Ctrl+Shift+E also work)
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = ctrl+alt+shift+left=resize_split:left,40
keybind = ctrl+alt+shift+right=resize_split:right,40
keybind = ctrl+alt+shift+up=resize_split:up,20
keybind = ctrl+alt+shift+down=resize_split:down,20

# Tabs: Alt+1..9, Ctrl+Tab cycles
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+six=goto_tab:6
keybind = alt+seven=goto_tab:7
keybind = alt+eight=goto_tab:8
keybind = alt+nine=last_tab
keybind = ctrl+shift+comma=prompt_tab_title

# Output & navigation
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
keybind = ctrl+shift+h=write_scrollback_file:open
keybind = ctrl+shift+k=clear_screen
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Misc
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+backspace=undo
keybind = f11=toggle_fullscreen
